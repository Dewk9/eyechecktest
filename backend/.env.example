# =============================================================
# EYE Check backend configuration
# Copy to .env (or .env.development / .env.test / .env.production)
# Load order: .env.<NODE_ENV>.local → .env.<NODE_ENV> → .env  (first value wins)
# NEVER commit real values. NEVER expose these to the browser.
# =============================================================

NODE_ENV=development

# ---------- Supabase (required) ----------
# Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# service_role key — backend only, bypasses RLS. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Postgres connection string — only used by `npm run db:migrate`
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_SCREENING_BUCKET=screening-images
SUPABASE_DATASET_BUCKET=eye-datasets

# ---------- Roboflow (optional — AI shows "Not Connected" when empty) ----------
ROBOFLOW_API_KEY=
# Workflow Cloud API URL from Roboflow → Deploy Workflow → Cloud API (required for Workflow/DINOv3 models)
ROBOFLOW_WORKFLOW_URL=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=
ROBOFLOW_MODEL_VERSION=
ROBOFLOW_API_URL=https://api.roboflow.com
ROBOFLOW_TIMEOUT_MS=30000

# ---------- Server ----------
BACKEND_PORT=3000
# Origin allowed by CORS (the frontend is served by this backend by default)
FRONTEND_URL=http://localhost:3000
SERVE_FRONTEND=true
TRUST_PROXY=false
FORCE_HTTPS=false
COOKIE_SECURE=false

# ---------- Security ----------
# Random string, at least 32 characters. Used as HMAC key for registration
# codes and anonymous visitor ids. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Optional (recommended): dedicated key (>= 32 chars) for AES-256-GCM encryption of staff
# registration codes so admins can view/copy them later. If empty, a key derived from
# JWT_SECRET is used. Keep it stable — changing it makes stored codes unviewable
# (they still work for registration, which uses the HMAC hash).
REGISTRATION_CODE_KEY=
# Synthetic e-mail domain for username-based Supabase Auth accounts (no mail is ever sent)
AUTH_EMAIL_DOMAIN=users.eyecheck.example.com
REMEMBER_ME_DAYS=30
UPLOAD_MAX_MB=8
